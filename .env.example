# Copy to `.env.local` for local overrides (optional).

# Canonical site URL used for metadata / sitemap
# (defaults in code to https://www.streakspot.com).
# NEXT_PUBLIC_SITE_URL=https://www.streakspot.com

# Set when store listings are public. Empty App Store URL shows “In review”.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Direct APK file. Defaults to the public GitHub Release asset.
# NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/ernshahi/streak-spot-web/releases/latest/download/StreakSpot.apk
